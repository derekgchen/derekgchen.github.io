---
import '../styles/global.css';
import { site } from '../data/site';
import { experiencePages } from '../data/experience';
import { fontsHref, tokenStyle } from '../design/themes';

interface Props {
  title?: string;
  description?: string;
  /** Wider content column, for pages like Experience that need room. */
  wide?: boolean;
}

const { title, description = site.description, wide = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;


const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
// Experience is an always-open group of its category pages.
const experienceLinks = experiencePages.map((p) => ({ href: `/experience/${p.slug}/`, label: p.label }));

// Contact icons: Tabler Icons "filled" set (MIT license, tabler.io/icons), 24×24.
const contacts = [
  {
    label: 'Email',
    href: `mailto:${site.email}`,
    icon: '<path d="M22 7.535v9.465a3 3 0 0 1 -2.824 2.995l-.176 .005h-14a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-9.465l9.445 6.297l.116 .066a1 1 0 0 0 .878 0l.116 -.066l9.445 -6.297z"/><path d="M19 4c1.08 0 2.027 .57 2.555 1.427l-9.555 6.37l-9.555 -6.37a2.999 2.999 0 0 1 2.354 -1.42l.201 -.007h14z"/>',
  },
  {
    label: 'GitHub',
    href: site.github,
    icon: '<path d="M5.315 2.1c.791 -.113 1.9 .145 3.333 .966l.272 .161l.16 .1l.397 -.083a13.3 13.3 0 0 1 4.59 -.08l.456 .08l.396 .083l.161 -.1c1.385 -.84 2.487 -1.17 3.322 -1.148l.164 .008l.147 .017l.076 .014l.05 .011l.144 .047a1 1 0 0 1 .53 .514a5.2 5.2 0 0 1 .397 2.91l-.047 .267l-.046 .196l.123 .163c.574 .795 .93 1.728 1.03 2.707l.023 .295l.007 .272c0 3.855 -1.659 5.883 -4.644 6.68l-.245 .061l-.132 .029l.014 .161l.008 .157l.004 .365l-.002 .213l-.003 3.834a1 1 0 0 1 -.883 .993l-.117 .007h-6a1 1 0 0 1 -.993 -.883l-.007 -.117v-.734c-1.818 .26 -3.03 -.424 -4.11 -1.878l-.535 -.766c-.28 -.396 -.455 -.579 -.589 -.644l-.048 -.019a1 1 0 0 1 .564 -1.918c.642 .188 1.074 .568 1.57 1.239l.538 .769c.76 1.079 1.36 1.459 2.609 1.191l.001 -.678l-.018 -.168a5.03 5.03 0 0 1 -.021 -.824l.017 -.185l.019 -.12l-.108 -.024c-2.976 -.71 -4.703 -2.573 -4.875 -6.139l-.01 -.31l-.004 -.292a5.6 5.6 0 0 1 .908 -3.051l.152 -.222l.122 -.163l-.045 -.196a5.2 5.2 0 0 1 .145 -2.642l.1 -.282l.106 -.253a1 1 0 0 1 .529 -.514l.144 -.047l.154 -.03z"/>',
  },
  {
    label: 'LinkedIn',
    href: site.linkedin,
    icon: '<path d="M17 2a5 5 0 0 1 5 5v10a5 5 0 0 1 -5 5h-10a5 5 0 0 1 -5 -5v-10a5 5 0 0 1 5 -5zm-9 8a1 1 0 0 0 -1 1v5a1 1 0 0 0 2 0v-5a1 1 0 0 0 -1 -1m6 0a3 3 0 0 0 -1.168 .236l-.125 .057a1 1 0 0 0 -1.707 .707v5a1 1 0 0 0 2 0v-3a1 1 0 0 1 2 0v3a1 1 0 0 0 2 0v-3a3 3 0 0 0 -3 -3m-6 -3a1 1 0 0 0 -.993 .883l-.007 .127a1 1 0 0 0 1.993 .117l.007 -.127a1 1 0 0 0 -1 -1"/>',
  },
];
---

<!doctype html>
<html lang="en" style={tokenStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {site.writingListed && <link rel="alternate" type="application/rss+xml" title={`${site.name} · Writing`} href="/rss.xml" />}
    {!site.writingListed && path.startsWith('/writing/') && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
  </head>
  <body>
    <div class:list={['shell', { wide }]}>
      <aside class="sidebar">
        <a href="/" class="name">{site.name}</a>
        <p class="degrees">
          {site.degrees.map((d) => <span>{d}</span>)}
        </p>

        <ul class="contacts">
          {contacts.map((c) => (
            <li>
              <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} aria-label={c.label} title={c.label}>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={c.icon} />
              </a>
            </li>
          ))}
        </ul>

        <nav aria-label="Main">
          <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>About</a>
          <div class="group">
            <span class:list={['group-label', { current: isCurrent('/experience/') }]}>Experience</span>
            <ul>
              {experienceLinks.map((n) => (
                <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
              ))}
              <li><a href={site.resume} target="_blank">Résumé</a></li>
            </ul>
          </div>
          {site.writingListed && <a href="/writing/" aria-current={isCurrent('/writing/') ? 'page' : undefined}>Writing</a>}
        </nav>
      </aside>

      <div class="content">
        <main>
          <slot />
        </main>
        <footer>© {new Date().getFullYear()} {site.name}</footer>
      </div>
    </div>
  </body>
</html>

<style>
  /* Sidebar + content as one centered unit. Its width is the same on every
     page so the sidebar never moves; regular pages cap their text column. */
  .shell {
    --sidebar: 220px;
    --gap: 72px;
    --column: 820px;
    display: grid;
    grid-template-columns: var(--sidebar) minmax(0, 1fr);
    gap: var(--gap);
    max-width: calc(var(--sidebar) + var(--gap) + var(--column) + 2 * 40px);
    margin: 0 auto;
    padding: 0 40px;
    min-height: 100vh;
    isolation: isolate;
  }

  /* Sidebar panel: a full-height band of --bg-side from the window's left edge
     to 16px past the sidebar column. */
  .shell::before {
    content: '';
    position: fixed;
    inset: 0 auto 0 0;
    z-index: -1;
    width: calc(
      (100vw - min(100vw, var(--sidebar) + var(--gap) + var(--column) + 80px)) / 2
      + 40px + var(--sidebar) + 16px
    );
    background: var(--bg-side);
  }

  /* ─── Sidebar ─── */
  .sidebar {
    position: sticky;
    top: 0;
    align-self: start;
    padding: 80px 0 32px;
  }

  .name {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--accent);
    text-decoration: none;
  }

  .degrees {
    display: flex;
    flex-direction: column;
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
  }

  /* Pulled left so the first icon's glyph lines up with the text above:
     (38px target - 22px icon) / 2 = 8px, plus the icon's ~1px inner padding at this size. */
  .contacts {
    list-style: none;
    display: flex;
    gap: 4px;
    margin: 14px 0 0 -9px;
  }

  .contacts a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    color: var(--accent);
    transition: color 0.15s, background 0.15s;
  }

  .contacts a:hover { color: var(--text); background: var(--bg-alt); }
  .contacts svg { width: 22px; height: 22px; }

  nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 36px;
  }

  nav a {
    color: var(--muted);
    font-size: 17px;
    text-decoration: none;
    transition: color 0.15s;
  }

  nav a:hover { color: var(--text); }

  nav a[aria-current='page'] {
    color: var(--accent);
    font-weight: 600;
  }

  /* Experience group: a label with smaller, indented pages beneath. */
  .group-label {
    font-size: 17px;
    color: var(--muted);
  }

  .group-label.current { color: var(--text); }

  .group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-top: 8px;
    padding-left: 20px;
  }

  .group ul a { font-size: 14px; }

  /* ─── Content ─── */
  .content {
    padding: 80px 0 40px;
    display: flex;
    flex-direction: column;
  }

  main { flex: 1; }
  .shell:not(.wide) main,
  .shell:not(.wide) footer { max-width: 600px; }

  footer {
    margin-top: 96px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    font-size: 13px;
    color: var(--muted);
  }

  /* ─── Narrow screens: sidebar becomes a header ─── */
  @media (max-width: 860px) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding: 0 20px;
    }

    /* Phones: the panel becomes the header's background instead. */
    .shell::before { content: none; }

    .sidebar {
      position: static;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: start;
      margin: 0 -20px;
      padding: 24px 20px 16px;
      background: var(--bg-side);
    }

    .degrees { grid-column: 1; font-size: 13px; margin-top: 4px; }
    .contacts { grid-column: 2; grid-row: 1 / 3; margin: -4px -6px 0 0; }

    nav {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px 18px;
      margin-top: 16px;
    }

    /* Flatten the Experience group into the row. */
    .group,
    .group ul,
    .group li { display: contents; }
    .group-label { display: none; }
    nav a,
    .group ul a { font-size: 15px; }

    .content { padding: 32px 0; }
    footer { margin-top: 64px; }
  }
</style>
