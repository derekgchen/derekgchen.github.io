---
import { Image } from 'astro:assets';
import profilePic from '../assets/website_pic_2.png';
import Layout from '../layouts/Layout.astro';
import { experiences } from '../data/experience';
import { recently, recentlyUpdated, stuckInMyHead as song } from '../data/updates';

// Organization websites, from the Experience data.
const urlOf = (id: string) => experiences.find((x) => x.id === id)?.url;
---

<Layout>
  <section class="about">
    <Image class="photo" src={profilePic} alt="Derek Chen" widths={[160, 320]} sizes="160px" loading="eager" />
    <h1>Hi, I'm Derek.</h1>

    <div class="prose">
      <p>
        I build generative models for biology, and I am broadly interested in deep learning, statistical modeling,
        and spatial biology. I'm working on my M.Eng. thesis on point cloud–based protein modeling,
        advised by <a href={urlOf('barzilay-group')} target="_blank">Regina Barzilay</a>, and research chromatin structure
        prediction in the <a href={urlOf('zhang-group')} target="_blank">Zhang Group</a>. I've also been fortunate to
        intern at <a href={urlOf('hrt')} target="_blank">Hudson River Trading</a> and
        <a href={urlOf('sig')} target="_blank">Susquehanna</a>.
      </p>
      <p>
        I've been involved in Science Olympiad since high school and spent two years directing
        <a href={urlOf('scioly')} target="_blank">MIT's invitational tournament</a>. In my free time, you can find me running,
        singing along to musicals, and sampling the most scrumptious pastries.
      </p>
    </div>
  </section>

  <section class="recent">
    <div class="recent-head">
      <h2>Recently, I've...</h2>
      <p class="label">Updated {recentlyUpdated}</p>
    </div>
    <ul>
      {/* One span per line, so text and links stay together beside the arrow. */}
      {recently.map((line) => <li><span set:html={line} /></li>)}
    </ul>

    <p class="song">
      <span class="song-label">Stuck in my head...</span>
      {song.url ? <a class="song-title" href={song.url} target="_blank">{song.title}</a> : <span class="song-title">{song.title}</span>}
      <span class="song-artist">· {song.artist}</span>
    </p>
  </section>
</Layout>

<style>
  .about :global(.photo) {
    float: right;
    width: 160px;
    height: 160px;
    margin: 0 0 16px 32px;
    border-radius: 50%;
    object-fit: cover;
    /* Double accent ring: a thin one touching the photo, and one around it
       after a small gap. */
    border: 1px solid var(--accent);
    outline: 4px solid var(--accent);
    outline-offset: 4px;
  }

  h1 {
    font-size: clamp(36px, 7vw, 52px);
    margin-bottom: 28px;
  }

  .prose { font-size: 17px; }
  .prose p + p { margin-top: 16px; }

  .recent {
    clear: both;
    margin-top: 64px;
  }

  .recent-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 16px;
  }

  .recent h2 { font-size: 28px; }
  .recent ul { list-style: none; font-size: 17px; }
  .recent li + li { margin-top: 6px; }

  /* Arrow bullet, with wrapped lines aligned to the text. */
  .recent li {
    display: flex;
    gap: 10px;
  }

  .recent li::before {
    content: '→';
    color: var(--accent);
  }

  /* Solid accent box, like the timeline bars. */
  .song {
    margin-top: 24px;
    padding: 14px 18px;
    border-radius: 10px;
    background: var(--accent);
    color: var(--on-accent);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 6px;
    font-size: 17px;
  }

  .song-label {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .song-label::after {
    content: '♪';
    margin-left: 10px;
    font-weight: 400;
  }

  .song-title {
    font-weight: 500;
    color: inherit;
    text-decoration: none;
  }

  /* Fade with color, not opacity, which would also fade the hover underline
     and the selection highlight. */
  a.song-title::after { color: color-mix(in srgb, currentColor 75%, transparent); }
  a.song-title:hover { text-decoration: underline; text-underline-offset: 3px; }

  .song-artist { color: color-mix(in srgb, currentColor 75%, transparent); }

  /* The site's selection color is a light accent tint, which vanishes on the
     solid accent box; invert it here. */
  .song::selection,
  .song ::selection {
    background: var(--on-accent);
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .about :global(.photo) {
      float: none;
      display: block;
      width: 112px;
      height: 112px;
      margin: 0 0 20px;
    }
  }
</style>
