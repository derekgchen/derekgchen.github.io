---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/writing';

const posts = await getPosts();
---

<Layout title="Writing" description="Writing by Derek Chen.">
  <h1>Writing</h1>
  <p class="intro">
    Notes and essays, mostly on machine learning, biology, and things I'm learning.
    Subscribe via <a href="/rss.xml">RSS</a>.
  </p>

  {posts.length > 0 ? <PostList posts={posts} /> : <p class="empty">Nothing here yet. Check back soon.</p>}
</Layout>

<style>
  h1 { font-size: 40px; margin-bottom: 12px; }
  .intro { color: var(--muted); margin-bottom: 40px; }
  .empty { color: var(--muted); }
</style>
