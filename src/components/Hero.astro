---
import { Image } from 'astro:assets';
import profilePic from '../assets/website_pic_2.png';
import { site } from '../data/site';
---

<section class="hero">
  <div class="hero-content">
    <div class="hero-eyebrow">
      <span class="hero-eyebrow-line"></span>
      <span>MIT · Course 6-3 &amp; 7</span>
    </div>
    <h1>Derek<br /><em>Chen.</em></h1>
    <p class="hero-subtitle">Computer Science &amp; Biology, Senior</p>
    <p class="hero-desc">
      Hi! I'm Derek — a senior at MIT double-majoring in Computer Science and Biology. I'm interested in the intersection of computation and life sciences. Feel free to look around!
    </p>
    <div class="hero-links">
      <a href={`mailto:${site.email}`} class="contact-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg>
        {site.email}
      </a>
      <a href={site.linkedin} class="contact-link" target="_blank">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="3"/><path d="M7 10v7M7 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/></svg>
        LinkedIn
      </a>
      <a href={site.github} class="contact-link" target="_blank">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
        GitHub
      </a>
    </div>
  </div>
  <div class="hero-visual">
    <div class="profile-frame">
      <div class="profile-inner">
        <Image src={profilePic} alt="Derek Chen" widths={[280, 560]} sizes="280px" loading="eager" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 60px 80px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero-content {
    flex: 1;
    max-width: 600px;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeUp 0.8s 0.1s forwards;
  }

  .hero-eyebrow span {
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--teal);
  }

  .hero-eyebrow-line {
    width: 40px;
    height: 1px;
    background: var(--teal-muted);
  }

  h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(52px, 7vw, 88px);
    line-height: 1.0;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-bottom: 8px;
    opacity: 0;
    animation: fadeUp 0.8s 0.2s forwards;
  }

  h1 em {
    font-style: italic;
    color: var(--gold);
  }

  .hero-subtitle {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 18px;
    color: var(--text-muted);
    margin-bottom: 32px;
    opacity: 0;
    animation: fadeUp 0.8s 0.35s forwards;
  }

  .hero-desc {
    font-size: 16px;
    line-height: 1.75;
    color: var(--text-muted);
    max-width: 480px;
    margin-bottom: 48px;
    opacity: 0;
    animation: fadeUp 0.8s 0.45s forwards;
  }

  .hero-links {
    display: flex;
    gap: 20px;
    align-items: center;
    opacity: 0;
    animation: fadeUp 0.8s 0.55s forwards;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 0.05em;
    padding: 10px 20px;
    border: 1px solid var(--border);
    border-radius: 2px;
    transition: all 0.25s;
  }

  .contact-link:hover {
    border-color: var(--teal-muted);
    color: var(--teal);
    background: rgba(74, 173, 139, 0.06);
  }

  .contact-link svg { width: 16px; height: 16px; }

  .hero-visual {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: fadeIn 1.2s 0.6s forwards;
  }

  .profile-frame {
    position: relative;
    width: 280px;
    height: 280px;
  }

  .profile-frame::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    background: conic-gradient(var(--teal), var(--gold), var(--teal));
    animation: spin 8s linear infinite;
  }

  .profile-frame::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--bg);
  }

  .profile-inner {
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    background: var(--surface);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .profile-inner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .hero { padding: 120px 32px 80px; flex-direction: column; gap: 60px; }
  }

  @media (max-width: 600px) {
    .hero { padding: 100px 20px 60px; }
    .hero-links { flex-wrap: wrap; }
    .profile-frame { width: 220px; height: 220px; }
  }
</style>
