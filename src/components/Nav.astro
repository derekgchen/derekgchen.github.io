---
import { site } from '../data/site';
---

<nav>
  <a href="/" class="nav-name">{site.name}</a>
  <span class="nav-sep">◆</span>
  <a href="/">Home</a>
  <a href="/#school">School</a>
  <a href={site.resume} target="_blank">Résumé</a>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 20px 60px;
    display: flex;
    align-items: center;
    gap: 32px;
    background: linear-gradient(to bottom, rgba(10,14,12,0.95) 0%, transparent 100%);
    backdrop-filter: blur(2px);
  }

  .nav-name {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    color: var(--gold);
    text-decoration: none;
    letter-spacing: 0.02em;
    margin-right: auto;
    transition: color 0.2s;
  }
  .nav-name:hover { color: var(--gold-light); }

  .nav-sep {
    color: var(--text-dim);
    font-size: 10px;
  }

  nav a:not(.nav-name) {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  nav a:not(.nav-name):hover { color: var(--gold-light); }

  @media (max-width: 900px) {
    nav { padding: 20px 32px; }
  }

  @media (max-width: 600px) {
    nav { gap: 16px; padding: 16px 20px; }
  }
</style>
