---
interface Props {
  title: string;
  courses: string[];
}

const { title, courses } = Astro.props;
---

<div class="course-group reveal">
  <div class="course-group-title">{title}</div>
  <ul class="course-list">
    {courses.map((course) => <li>{course}</li>)}
  </ul>
</div>

<style>
  .course-group {
    margin-bottom: 48px;
  }

  .course-group-title {
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }

  .course-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 0;
  }

  .course-list li {
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.5;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    transition: color 0.2s;
  }

  .course-list li:hover { color: var(--text); }

  .course-list li::before {
    content: '→';
    color: var(--text-dim);
    font-size: 12px;
    margin-top: 2px;
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .course-list { grid-template-columns: 1fr; }
  }
</style>
