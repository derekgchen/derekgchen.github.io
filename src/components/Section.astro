---
interface Props {
  num: string;
  title: string;
  accent: string;
  intro?: string;
  id?: string;
}

const { num, title, accent, intro, id } = Astro.props;
---

<section class="section" id={id}>
  <div class="section-header reveal">
    <span class="section-num">{num}</span>
    <h2>{title} <em>{accent}</em></h2>
  </div>
  {intro && <p class="section-intro reveal">{intro}</p>}
  <slot />
</section>

<style>
  .section {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 60px;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 48px;
  }

  .section-num {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--text-dim);
    text-transform: uppercase;
  }

  h2 {
    font-family: 'Playfair Display', serif;
    font-size: 36px;
    font-weight: 400;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  h2 em {
    font-style: italic;
    color: var(--gold);
  }

  .section-intro {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 17px;
    color: var(--text-muted);
    margin-bottom: 48px;
    max-width: 600px;
  }

  @media (max-width: 900px) {
    .section { padding: 60px 32px; }
  }

  @media (max-width: 600px) {
    .section { padding: 48px 20px; }
  }
</style>
