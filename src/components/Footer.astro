---
import { site } from '../data/site';
---

<footer class="reveal">
  <div class="footer-name">{site.name} · MIT</div>
  <div class="footer-links">
    <a href={`mailto:${site.email}`}>Email</a>
    <a href={site.github} target="_blank">GitHub</a>
    <a href={site.linkedin} target="_blank">LinkedIn</a>
    <a href={site.resume} target="_blank">Résumé</a>
  </div>
</footer>

<style>
  footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--border);
    padding: 32px 60px;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-name {
    font-family: 'Playfair Display', serif;
    font-size: 14px;
    color: var(--text-dim);
  }

  .footer-links {
    display: flex;
    gap: 24px;
  }

  .footer-links a {
    color: var(--text-dim);
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .footer-links a:hover { color: var(--gold); }

  @media (max-width: 900px) {
    footer { padding: 32px; flex-direction: column; gap: 16px; text-align: center; }
  }
</style>
